	"item": [
		{
			"name": "User Referral APIs",
			"item": [
				{
					"name": "Get Referral Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"messageData\": \"Join me on this amazing platform!\",\n  \"referralCode\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/getReferralCode",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"getReferralCode"
							]
						},
						"description": "Generate or get user's referral code. If user doesn't have a referral code, it generates a unique 5-character code. Returns the referral link."
					},
					"response": [
						{
							"name": "Success - New Code Generated",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"userId\": \"507f1f77bcf86cd799439011\",\n  \"messageData\": \"Join me!\",\n  \"referralCode\": \"\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/getReferralCode",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"getReferralCode"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [],
							"cookie": [],
							"body": "{\n  \"code\": \"200\",\n  \"response\": {\n    \"userId\": \"507f1f77bcf86cd799439011\",\n    \"message\": \"Join me!\",\n    \"referralCode\": \"AB123\",\n    \"referralLink\": \"https://yoursite.com/referral/AB123\"\n  }\n}"
						}
					]
				},
