							"if (jsonData.status === 200 && jsonData.result && jsonData.result._id) {",
							"    pm.environment.set(\"CAPSULE_ID\", jsonData.result._id);",
							"    console.log(\"Capsule ID saved: \" + jsonData.result._id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{}"
				},
				"url": {
					"raw": "http://localhost:3002/capsules/create",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3002",
					"path": ["capsules", "create"]
				},
				"description": "Creates a new stream (capsule). Returns capsule_id which we'll use in subsequent requests."
			},
			"response": []
		},
		{
			"name": "3. Configure Stream (Birthday Group Settings)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "capsule_id",
						"value": "{{CAPSULE_ID}}",
						"description": "Capsule ID from step 2"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"John's Birthday Stream 2025\",\n  \"makingFor\": \"OTHERS\",\n  \"CapsuleFor\": \"Stream\",\n  \"StreamType\": \"Group\",\n  \"StreamFlow\": \"Birthday\",\n  \"participation\": \"friend-group\",\n  \"OwnerAnswer\": true,\n  \"IsOwnerPostsForMember\": true,\n  \"IsPurchaseNeededForAllPosts\": false,\n  \"Frequency\": \"medium\",\n  \"MonthFor\": \"M12\",\n  \"price\": 0,\n  \"LaunchSettings\": {\n    \"OwnerBirthday\": \"1990-05-15\"\n  }\n}"
				},
				"url": {
					"raw": "http://localhost:3002/capsules/saveSettings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3002",
					"path": ["capsules", "saveSettings"]
				},
				"description": "Configure the stream as a Birthday Group Stream with all settings:\n- StreamType: Group (multiple people)\n- StreamFlow: Birthday\n- OwnerAnswer: true (owner can participate)\n- Frequency: medium (posts every 2-3 days)\n- MonthFor: M12 (12 months duration)"
			},
			"response": []
