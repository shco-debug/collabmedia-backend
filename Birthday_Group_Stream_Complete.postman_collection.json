		{
			"name": "6. Create Page - Question 1",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Ensure CHAPTER_ID is available",
							"var chapterId = pm.environment.get('CHAPTER_ID');",
							"if (!chapterId) {",
							"    console.error('ERROR: CHAPTER_ID is not set! Run Step 5 first.');",
							"} else {",
							"    console.log('Using CHAPTER_ID: ' + chapterId);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.status === 200 && jsonData.result && jsonData.result._id) {",
							"    pm.environment.set(\"PAGE_ID_1\", jsonData.result._id);",
							"    console.log(\"Page 1 ID saved: \" + jsonData.result._id);",
							"} else {",
							"    console.error('ERROR: Failed to create page:', jsonData);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "chapter_id",
						"value": "{{CHAPTER_ID}}",
						"type": "text",
						"description": "REQUIRED: Chapter ID from Step 5"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"page_type\": \"gallery\"\n}"
				},
