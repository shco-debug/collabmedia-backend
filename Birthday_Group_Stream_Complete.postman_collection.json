					"raw": "http://localhost:3002/pages/create",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3002",
					"path": ["pages", "create"]
				},
				"description": "Create a page (question) within the chapter. Type 'gallery' is for search gallery questions.\n\nREQUIRED HEADER: chapter_id must be set from Step 5!"
			},
			"response": []
