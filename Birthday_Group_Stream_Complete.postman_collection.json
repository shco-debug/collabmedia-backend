				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"your-email@example.com\",\n  \"password\": \"your-password\"\n}"
				},
				"url": {
					"raw": "http://localhost:3002/user/signin",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3002",
					"path": ["user", "signin"]
				},
				"description": "Login to get session cookie. Save the session cookie for subsequent requests."
			},
			"response": []
		},
